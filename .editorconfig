# .editorconfig
[*.cs]

# Naming styles
dotnet_naming_style.private_fields_underscore.style = _camelCase
dotnet_naming_style.private_fields_underscore.required_prefix = _
dotnet_naming_style.private_fields_underscore.capitalization = camel_case

# Symbol specification
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =

# Naming rule
dotnet_naming_rule.private_fields_should_have_underscore.severity = suggestion
dotnet_naming_rule.private_fields_should_have_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_should_have_underscore.style = private_fields_underscore
